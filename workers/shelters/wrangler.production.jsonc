{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safe-korea-shelter-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:8765,http://127.0.0.1:8766,http://localhost:8765,http://localhost:8766"
  },
  "ratelimits": [
    {
      "name": "UPSTREAM_REGION_LIMIT",
      "namespace_id": "731001",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "UPSTREAM_TOTAL_LIMIT",
      "namespace_id": "731002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
