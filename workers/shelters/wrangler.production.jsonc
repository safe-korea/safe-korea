{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safe-korea-shelter-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../../build/web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:8765,http://127.0.0.1:8766,http://localhost:8765,http://localhost:8766,https://safe-korea-shelter-api.trovapp.workers.dev",
    "GOV_ALERT_SEMANTICS_VERIFIED": "false"
  },
  "ratelimits": [
    {
      "name": "UPSTREAM_REGION_LIMIT",
      "namespace_id": "731001",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "UPSTREAM_TOTAL_LIMIT",
      "namespace_id": "731002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PUSH_REQUEST_LIMIT",
      "namespace_id": "731003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "PUSH_DB",
      "database_name": "safe-kor-web-push",
      "database_id": "9f338e58-9c51-496a-b60b-9c08653dd836"
    }
  ],
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  }
}
